{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sequico/server-noonien",
  "title": "server-noonien",
  "description": "Shared, serverless, conflict-free knowledge-graph memory for AI agents",
  "repository": {
    "url": "https://github.com/sequico/server-noonien",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/sequico/server-noonien/main/assets/icon.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "server-noonien",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NOONIEN_DIR",
          "description": "Directory holding this machine's shards (default ~/.noonien).",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "NOONIEN_NODE_ID",
          "description": "This node's shard name (default the hostname). Must be unique per machine.",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
